<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="BaseGun">
		<defName>VoidAwake_Gun_GhostMusket</defName>
		<label>マスケット銃</label>
		<description>亡霊が使う古いマスケット。射程は長いが、撃つまでに時間がかかる。</description>
		<graphicData>
			<texPath>Entities/Pirate/Gun</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<tradeability>None</tradeability>
		<destroyOnDrop>true</destroyOnDrop>
		<equippedAngleOffset>-45</equippedAngleOffset>
		<weaponClasses>
			<li>LongShots</li>
		</weaponClasses>
		<weaponTags>
			<li>VoidAwake_GhostMusket</li>
		</weaponTags>
		<statBases>
			<Mass>4.5</Mass>
			<AccuracyTouch>0.55</AccuracyTouch>
			<AccuracyShort>0.70</AccuracyShort>
			<AccuracyMedium>0.82</AccuracyMedium>
			<AccuracyLong>0.78</AccuracyLong>
			<RangedWeapon_Cooldown>2.8</RangedWeapon_Cooldown>
		</statBases>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_BoltActionRifle</defaultProjectile>
				<warmupTime>2.2</warmupTime>
				<range>36.9</range>
				<soundCast>Shot_BoltActionRifle</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>銃床</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>銃身</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
	</ThingDef>

	<ThingDef ParentName="BaseWeapon">
		<defName>VoidAwake_Weapon_AcidFlask</defName>
		<label>硫酸瓶</label>
		<description>硫酸の入った瓶。着弾地点の周囲に酸をまき散らし、短時間ただれさせる。</description>
		<graphicData>
			<texPath>Things/Item/Equipment/WeaponRanged/Molotov</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<uiIconScale>1.3</uiIconScale>
		<soundInteract>Interact_MolotovCocktail</soundInteract>
		<techLevel>Industrial</techLevel>
		<tradeability>None</tradeability>
		<destroyOnDrop>true</destroyOnDrop>
		<weaponClasses>
			<li>Ranged</li>
		</weaponClasses>
		<weaponTags>
			<li>VoidAwake_AcidFlask</li>
		</weaponTags>
		<statBases>
			<Mass>1</Mass>
			<RangedWeapon_Cooldown>2.66</RangedWeapon_Cooldown>
		</statBases>
		<verbs>
			<li>
				<label>硫酸瓶を投げる</label>
				<verbClass>Verb_LaunchProjectile</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<range>12.9</range>
				<forcedMissRadius>1.9</forcedMissRadius>
				<warmupTime>1.5</warmupTime>
				<noiseRadius>4</noiseRadius>
				<soundCast>ThrowMolotovCocktail</soundCast>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<defaultProjectile>VoidAwake_Proj_AcidFlask</defaultProjectile>
				<rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
			</li>
		</verbs>
	</ThingDef>

	<ThingDef ParentName="BaseGrenadeProjectile">
		<defName>VoidAwake_Proj_AcidFlask</defName>
		<label>硫酸瓶</label>
		<thingClass>VoidAwake.VoidAwake_Projectile_AcidFlask</thingClass>
		<graphicData>
			<texPath>Things/Projectile/Molotov</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
			<damageDef>AcidBurn</damageDef>
			<damageAmountBase>4</damageAmountBase>
			<explosionRadius>0.2</explosionRadius>
			<speed>12</speed>
			<arcHeightFactor>2</arcHeightFactor>
			<shadowSize>0.6</shadowSize>
			<ai_IsIncendiary>false</ai_IsIncendiary>
		</projectile>
	</ThingDef>

</Defs>
