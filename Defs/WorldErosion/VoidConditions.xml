<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- LV1: Light -->
	<GameConditionDef>
		<defName>VoidAwake_Erosion_Light</defName>
		<conditionClass>GameCondition</conditionClass>
		<label>ヴォイドの浸食LV１</label>
		<description>ヴォイドによる浸食が始まっています、影響は軽微ですが浸食が進むにつれより異常な出来事が発生します。</description>
		<endMessage>虚無浸食がこの地から退きました。</endMessage>
		<canBePermanent>true</canBePermanent>
		<exclusiveConditions>
			<li>VoidAwake_Erosion_Medium</li>
			<li>VoidAwake_Erosion_Heavy</li>
			<li>VoidAwake_Erosion_Extreme</li>
		</exclusiveConditions>
	</GameConditionDef>

	<!-- LV2: Medium -->
