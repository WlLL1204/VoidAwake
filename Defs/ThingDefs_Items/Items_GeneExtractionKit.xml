<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- 遺伝子抽出キット（消耗アイテム） -->
	<ThingDef ParentName="ResourceBase">
		<defName>VoidAwake_GeneExtractionKit</defName>
		<label>遺伝子抽出キット</label>
		<description>収容したシャンブラーから遺伝子情報を採取するための携帯用消耗キット。使用すると1つ消費され、対象の全遺伝子は削除されたうえで死亡する。</description>
		<graphicData>
			<!-- 仮テクスチャ: バニラバイオフェライト流用 -->
			<texPath>Things/Item/Resource/Bioferrite</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
			<color>(100,160,120)</color>
		</graphicData>
		<soundInteract>Metal_Drop</soundInteract>
		<soundDrop>Standard_Drop</soundDrop>
		<stackLimit>25</stackLimit>
		<healthAffectsPrice>false</healthAffectsPrice>
		<techLevel>Industrial</techLevel>
		<costList>
			<Steel>50</Steel>
			<ComponentIndustrial>2</ComponentIndustrial>
			<Bioferrite>10</Bioferrite>
		</costList>
		<statBases>
			<WorkToMake>6000</WorkToMake>
			<MaxHitPoints>50</MaxHitPoints>
			<MarketValue>80</MarketValue>
			<Mass>0.5</Mass>
			<Flammability>0.4</Flammability>
			<DeteriorationRate>1.0</DeteriorationRate>
		</statBases>
		<thingCategories>
			<li>Manufactured</li>
		</thingCategories>
		<recipeMaker>
			<researchPrerequisite>VoidAwake_GeneExtraction</researchPrerequisite>
			<recipeUsers Inherit="False">
				<li>TableMachining</li>
			</recipeUsers>
			<skillRequirements>
				<Crafting>4</Crafting>
			</skillRequirements>
			<displayPriority>410</displayPriority>
		</recipeMaker>
	</ThingDef>

</Defs>
