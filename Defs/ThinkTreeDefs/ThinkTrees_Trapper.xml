<?xml version="1.0" encoding="utf-8"?>

<Defs>
  <ThinkTreeDef>
    <defName>VoidAwake_Trapper</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>

        <li Class="ThinkNode_ConditionalMustKeepLyingDown">
          <subNodes>
            <li Class="ThinkNode_QueuedJob">
              <inBedOnly>true</inBedOnly>
            </li>
            <li Class="JobGiver_KeepLyingDown" />
          </subNodes>
        </li>

        <li Class="ThinkNode_Subtree">
          <treeDef>Downed</treeDef>
        </li>

        <li Class="ThinkNode_Subtree">
          <treeDef>BurningResponse</treeDef>
        </li>

        <li Class="ThinkNodeConditional_EscapingHoldingPlatform">
          <subNodes>
            <li Class="JobGiver_EscapingHoldingPlatform" />
          </subNodes>
        </li>

        <li Class="JobGiver_ReactToCloseMeleeThreat" />

        <li Class="VoidAwake.VoidAwake_ThinkNode_ConditionalTrapperKidnap">
          <subNodes>
            <li Class="VoidAwake.VoidAwake_JobGiver_TrapperKidnap" />
          </subNodes>
        </li>

        <li Class="ThinkNode_Subtree">
          <treeDef>MentalStateNonCritical</treeDef>
        </li>

        <li Class="ThinkNode_Subtree">
          <treeDef>LordDuty</treeDef>
        </li>

        <!-- Stealth: place traps, escape outside, reuse a passage before digging a new one, wait -->
        <li Class="VoidAwake.VoidAwake_ThinkNode_ConditionalTrapperStealth">
          <subNodes>
            <li Class="VoidAwake.VoidAwake_JobGiver_TrapperPlaceTrap" />
            <li Class="VoidAwake.VoidAwake_JobGiver_TrapperEscapeOutside" />
            <li Class="VoidAwake.VoidAwake_JobGiver_TrapperUseRabbitPassage" />
            <li Class="VoidAwake.VoidAwake_JobGiver_TrapperCreateRabbitPassage" />
            <li Class="ThinkNode_Tagger">
              <tagToGive>Idle</tagToGive>
              <subNodes>
                <li Class="VoidAwake.VoidAwake_JobGiver_TrapperWanderOutside">
                  <maxDanger>Deadly</maxDanger>
                  <ticksBetweenWandersRange>180~720</ticksBetweenWandersRange>
                  <wanderRadius>6</wanderRadius>
                </li>
              </subNodes>
            </li>
          </subNodes>
        </li>

        <!-- Combat: assault-like seek and fight; rabbit passages for flanking -->
        <li Class="VoidAwake.VoidAwake_ThinkNode_ConditionalTrapperCombat">
          <subNodes>
            <li Class="JobGiver_AIFightEnemies">
              <targetAcquireRadius>65</targetAcquireRadius>
              <targetKeepRadius>72</targetKeepRadius>
            </li>
            <li Class="VoidAwake.VoidAwake_JobGiver_TrapperCombatUseRabbitPassage" />
            <li Class="JobGiver_AIGotoNearestHostile" />
            <li Class="VoidAwake.VoidAwake_JobGiver_TrapperCombatCreateRabbitPassage" />
            <li Class="ThinkNode_Tagger">
              <tagToGive>Idle</tagToGive>
              <subNodes>
                <li Class="JobGiver_WanderAnywhere">
                  <maxDanger>Deadly</maxDanger>
                  <ticksBetweenWandersRange>180~720</ticksBetweenWandersRange>
                  <wanderRadius>12</wanderRadius>
                  <canBashDoors>false</canBashDoors>
                  <expireOnNearbyEnemy>true</expireOnNearbyEnemy>
                </li>
              </subNodes>
            </li>
          </subNodes>
        </li>

        <li Class="ThinkNode_SubtreesByTag">
          <insertTag>Metalhorror_PreWander</insertTag>
        </li>

        <li Class="JobGiver_IdleError"/>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <ThinkTreeDef>
    <defName>VoidAwake_TrapperConstant</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>Despawned</treeDef>
        </li>
        <li Class="ThinkNode_ConditionalCanDoLordJobNow">
          <subNodes>
            <li Class="ThinkNode_Subtree">
              <treeDef>LordDutyConstant</treeDef>
            </li>
          </subNodes>
        </li>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>
</Defs>
