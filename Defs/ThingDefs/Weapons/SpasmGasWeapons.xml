<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>VoidAwake_Gun_SpasmbombLauncher</defName>
    <label>痙縮投射機</label>
    <description>低圧のキャニスター投射機。着弾地点に痙縮ガスを数秒間放出する弾を撃ち出す。\n\n痙縮ガスに晒されると筋肉が収縮し、運動能力が低下して痛みが増していく。</description>
    <graphicData>
      <!-- 仮テクスチャ: スモークランチャー流用 -->
      <texPath>Things/Item/Equipment/WeaponRanged/SmokeLauncher</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(150,110,190)</color>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <generateCommonality>0.3</generateCommonality>
    <weaponClasses>
      <li>RangedHeavy</li>
    </weaponClasses>
    <weaponTags Inherit="False">
      <li>HeavyGun</li>
    </weaponTags>
    <tradeTags>
      <li>WeaponRanged</li>
    </tradeTags>
    <statBases>
      <WorkToMake>30000</WorkToMake>
      <Mass>3.4</Mass>
      <RangedWeapon_Cooldown>4.5</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>75</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <recipeMaker>
      <skillRequirements>
        <Crafting>4</Crafting>
      </skillRequirements>
      <displayPriority>471</displayPriority>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>VoidAwake_Bullet_SpasmbombLauncher</defaultProjectile>
        <warmupTime>3.5</warmupTime>
        <range>23.9</range>
        <forcedMissRadius>1.9</forcedMissRadius>
        <burstShotCount>1</burstShotCount>
        <soundCast>Shot_IncendiaryLauncher</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>14</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
      </li>
    </verbs>
    <tools>
      <li>
        <label>銃床</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>銃身</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>VoidAwake_Bullet_SpasmbombLauncher</defName>
    <label>痙縮投射弾</label>
    <graphicData>
      <texPath>Things/Projectile/LauncherShot</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <color>(150,110,190)</color>
    </graphicData>
    <thingClass>Projectile_Explosive</thingClass>
    <projectile>
      <speed>40</speed>
      <damageDef>VoidAwake_SpasmGas</damageDef>
      <explosionRadius>1.9</explosionRadius>
      <explosionRadiusDisplayPadding>2</explosionRadiusDisplayPadding>
      <arcHeightFactor>0.2</arcHeightFactor>
      <shadowSize>0.6</shadowSize>
      <screenShakeFactor>0.5</screenShakeFactor>
      <postExplosionSpawnThingDef>VoidAwake_SpasmGas_Releasing</postExplosionSpawnThingDef>
      <postExplosionSpawnThingDefWater>VoidAwake_SpasmGas_Releasing_Water</postExplosionSpawnThingDefWater>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseMakeableGrenade">
    <defName>VoidAwake_Weapon_GrenadeSpasm</defName>
    <label>痙縮グレネード</label>
    <description>着弾後に痙縮ガスを放出するグレネード。\n\n痙縮ガスに晒されると筋肉が収縮し、運動能力が低下して痛みが増していく。</description>
    <possessionCount>1</possessionCount>
    <tickerType>Normal</tickerType>
    <graphicData>
      <!-- 仮テクスチャ: EMPグレネード流用 -->
      <texPath>Things/Item/Equipment/WeaponRanged/EMPGrenades</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(150,110,190)</color>
    </graphicData>
    <uiIconScale>1.3</uiIconScale>
    <soundInteract>Interact_Grenade</soundInteract>
    <techLevel>Industrial</techLevel>
    <statBases>
      <Mass>1</Mass>
      <RangedWeapon_Cooldown>2.66</RangedWeapon_Cooldown>
      <WorkToMake>24000</WorkToMake>
    </statBases>
    <costList>
      <Steel>20</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
    </costList>
    <weaponTags>
      <li>GrenadeDestructive</li>
    </weaponTags>
    <thingCategories>
      <li>Grenades</li>
    </thingCategories>
    <verbs>
      <li>
        <label>痙縮グレネードを投げる</label>
        <verbClass>Verb_LaunchProjectile</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <range>12.9</range>
        <forcedMissRadius>1.9</forcedMissRadius>
        <warmupTime>1.5</warmupTime>
        <noiseRadius>4</noiseRadius>
        <ai_IsBuildingDestroyer>false</ai_IsBuildingDestroyer>
        <soundCast>ThrowGrenade</soundCast>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <defaultProjectile>VoidAwake_Proj_GrenadeSpasm</defaultProjectile>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>2.66</explosiveRadius>
        <explosiveDamageType>VoidAwake_SpasmGas</explosiveDamageType>
        <requiredDamageTypeToExplode>Flame</requiredDamageTypeToExplode>
        <postExplosionSpawnThingDef>VoidAwake_SpasmGas_Releasing</postExplosionSpawnThingDef>
      </li>
    </comps>
    <smeltable>true</smeltable>
  </ThingDef>

  <ThingDef ParentName="BaseGrenadeProjectile">
    <defName>VoidAwake_Proj_GrenadeSpasm</defName>
    <label>痙縮グレネード</label>
    <thingClass>Projectile_Explosive</thingClass>
    <graphicData>
      <texPath>Things/Projectile/GrenadeEMP</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(150,110,190)</color>
    </graphicData>
    <projectile>
      <damageDef>VoidAwake_SpasmGas</damageDef>
      <explosionDelay>100</explosionDelay>
      <explosionRadius>1.9</explosionRadius>
      <explosionRadiusDisplayPadding>2</explosionRadiusDisplayPadding>
      <screenShakeFactor>0.5</screenShakeFactor>
      <postExplosionSpawnThingDef>VoidAwake_SpasmGas_Releasing</postExplosionSpawnThingDef>
      <postExplosionSpawnThingDefWater>VoidAwake_SpasmGas_Releasing_Water</postExplosionSpawnThingDefWater>
    </projectile>
  </ThingDef>

</Defs>
