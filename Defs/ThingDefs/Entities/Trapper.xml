<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="BasePawn">
		<defName>Trapper</defName>
		<label>トラッパー</label>
		<description>可愛らしい兎のアノマリー。普段は身を隠し罠を張り狩りをする、獲物が罠に掛かったり、罠を見破られたと感じた時に姿を現す</description>
		<tradeability>None</tradeability>
		<hiddenWhileUndiscovered>true</hiddenWhileUndiscovered>
		<comps>
			<li Class="VoidAwake.CompProperties_VoidAwake_Trapper">
				<placeCooldownTicks>2500</placeCooldownTicks>
				<stealthReturnDelayTicks>180</stealthReturnDelayTicks>
				<combatMinDurationTicks>2500</combatMinDurationTicks>
				<passageUseTicks>120</passageUseTicks>
				<kidnapRetryTicks>120</kidnapRetryTicks>
			</li>
		</comps>
		<race>
			<baseHealthScale>1</baseHealthScale>
			<body>QuadrupedAnimalWithPaws</body>
			<baseBodySize>0.5</baseBodySize>
			<intelligence>ToolUser</intelligence>
			<leatherDef>Leather_Human</leatherDef>
			<needsRest>false</needsRest>
			<fleshType>EntityFlesh</fleshType>
			<isImmuneToInfections>true</isImmuneToInfections>
			<specificMeatDef>Meat_Human</specificMeatDef>
			<foodType>None</foodType>
			<bloodDef>Filth_DarkBlood</bloodDef>
			<bleedRateFactor>0.5</bleedRateFactor>
			<thinkTreeMain>VoidAwake_Trapper</thinkTreeMain>
			<thinkTreeConstant>VoidAwake_TrapperConstant</thinkTreeConstant>
			<trainability>None</trainability>
			<canBecomeShambler>true</canBecomeShambler>
			<lifeStageAges>
				<li>
					<def>EntityFullyFormed</def>
					<soundCall>Pawn_Sightstealer_Call</soundCall>
					<soundWounded>Pawn_Sightstealer_Wounded</soundWounded>
					<soundDeath>Pawn_Sightstealer_Death</soundDeath>
				</li>
			</lifeStageAges>
			<hediffGiverSets>
				<li>AnomalyEntity</li>
			</hediffGiverSets>
			<soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
			<hasGenders>false</hasGenders>
			<corpseHiddenWhileUndiscovered>true</corpseHiddenWhileUndiscovered>
		</race>
		<statBases>
			<MoveSpeed>3.6</MoveSpeed>
			<MinimumContainmentStrength>50</MinimumContainmentStrength>
			<ComfyTemperatureMin>-40</ComfyTemperatureMin>
			<ComfyTemperatureMax>60</ComfyTemperatureMax>
			<LeatherAmount>20</LeatherAmount>
			<MeatAmount>40</MeatAmount>
			<ToxicResistance>0.5</ToxicResistance>
		</statBases>
	</ThingDef>

	<PawnKindDef>
		<defName>Trapper</defName>
		<label>トラッパー</label>
		<race>Trapper</race>
		<overrideDeathOnDownedChance>0.25</overrideDeathOnDownedChance>
		<overrideDebugActionCategory>Entity</overrideDebugActionCategory>
		<immuneToTraps>true</immuneToTraps>
		<combatPower>55</combatPower>
		<ecoSystemWeight>0.5</ecoSystemWeight>
		<defaultFactionDef>Entities</defaultFactionDef>
		<startingHediffs>
			<li>
				<def>VoidAwake_TrapperStealth</def>
			</li>
		</startingHediffs>
		<lifeStages>
			<li>
				<bodyGraphicData>
					<texPath>Entitys/Trapper/Trapper</texPath>
					<graphicClass>Graphic_Multi</graphicClass>
					<drawSize>1.5</drawSize>
				</bodyGraphicData>
				<dessicatedBodyGraphicData>
					<texPath>Entitys/Trapper/Trapper</texPath>
					<graphicClass>Graphic_Multi</graphicClass>
					<drawSize>1.5</drawSize>
				</dessicatedBodyGraphicData>
			</li>
		</lifeStages>
	</PawnKindDef>

</Defs>
