<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>VoidAwake_SpasmGasExposure</defName>
    <label>痙縮ガス</label>
    <description>痙縮を誘発するガスへの曝露。筋肉が不随意に収縮し、運動能力が低下する。曝露が続くほど症状は進行し、ガスから離れても重度まで達していると回復に時間がかかる。\n\nガスマスクなど毒ガス曝露を防ぐ装備を着用していれば無効化される。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <maxSeverity>3</maxSeverity>
    <initialSeverity>0.01</initialSeverity>
    <isBad>true</isBad>
    <canApplyDodChanceForCapacityChanges>true</canApplyDodChanceForCapacityChanges>
    <stages>
      <li>
        <label>軽度</label>
        <minSeverity>0.5</minSeverity>
        <painOffset>0.10</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>中度</label>
        <minSeverity>1.5</minSeverity>
        <painOffset>0.20</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.35</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>重度</label>
        <minSeverity>2.5</minSeverity>
        <painOffset>0.35</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.61</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <!-- ガス外ではゆっくり減衰。重度(3)から消失までおおよそ 3/0.035 ≒ 85秒 -->
      <li Class="VoidAwake.VoidAwake_HediffCompProperties_SpasmGasExposure">
        <severityLossPerSecond>0.035</severityLossPerSecond>
        <leaveGraceTicks>60</leaveGraceTicks>
        <removeBelowSeverity>0.05</removeBelowSeverity>
      </li>
    </comps>
  </HediffDef>

</Defs>
