<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<HediffDef>
		<defName>VoidAwake_Ghost</defName>
		<label>亡霊</label>
		<description>ヴォイドに縛られた白骨の亡霊。痛みを感じない。</description>
		<hediffClass>HediffWithComps</hediffClass>
		<everCurableByItem>false</everCurableByItem>
		<duplicationAllowed>false</duplicationAllowed>
		<keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
		<stages>
			<li>
				<painFactor>0</painFactor>
				<statOffsets>
					<PainShockThreshold>10</PainShockThreshold>
					<ToxicResistance>1</ToxicResistance>
					<ComfyTemperatureMin>-100</ComfyTemperatureMin>
					<ComfyTemperatureMax>100</ComfyTemperatureMax>
				</statOffsets>
				<capMods>
					<li>
						<capacity>Talking</capacity>
						<postFactor>0</postFactor>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>

	<HediffDef>
		<defName>VoidAwake_Mortal</defName>
		<label>死すべき者</label>
		<description>死を重ねるほど鋭く、同時に脆くなる呪い。死亡するたびに戦闘能力が上がり、受ける傷も深くなる。三度死ぬと覚醒する。</description>
		<hediffClass>VoidAwake.VoidAwake_Hediff_Mortal</hediffClass>
		<isBad>false</isBad>
		<everCurableByItem>false</everCurableByItem>
		<duplicationAllowed>false</duplicationAllowed>
		<keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
		<initialSeverity>0.01</initialSeverity>
		<minSeverity>0</minSeverity>
		<maxSeverity>3</maxSeverity>
		<stages>
			<li>
				<label>未覚醒</label>
			</li>
			<li>
				<minSeverity>1</minSeverity>
				<label>一度目の死</label>
				<statOffsets>
					<MoveSpeed>0.5</MoveSpeed>
					<MeleeHitChance>4</MeleeHitChance>
				</statOffsets>
				<statFactors>
					<MeleeCooldownFactor>0.85</MeleeCooldownFactor>
					<AimingDelayFactor>0.85</AimingDelayFactor>
					<RangedCooldownFactor>0.85</RangedCooldownFactor>
					<IncomingDamageFactor>1.25</IncomingDamageFactor>
				</statFactors>
			</li>
			<li>
				<minSeverity>2</minSeverity>
				<label>二度目の死</label>
				<statOffsets>
					<MoveSpeed>1.0</MoveSpeed>
					<MeleeHitChance>8</MeleeHitChance>
				</statOffsets>
				<statFactors>
					<MeleeCooldownFactor>0.7</MeleeCooldownFactor>
					<AimingDelayFactor>0.7</AimingDelayFactor>
					<RangedCooldownFactor>0.7</RangedCooldownFactor>
					<IncomingDamageFactor>1.5</IncomingDamageFactor>
				</statFactors>
			</li>
			<li>
				<minSeverity>3</minSeverity>
				<label>覚醒</label>
				<statOffsets>
					<MoveSpeed>1.8</MoveSpeed>
					<MeleeHitChance>8</MeleeHitChance>
				</statOffsets>
				<statFactors>
					<MeleeCooldownFactor>0.5</MeleeCooldownFactor>
					<AimingDelayFactor>0.7</AimingDelayFactor>
					<RangedCooldownFactor>0.7</RangedCooldownFactor>
					<IncomingDamageFactor>1.5</IncomingDamageFactor>
				</statFactors>
			</li>
		</stages>
	</HediffDef>

</Defs>
