<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- LV1: Light -->
	<GameConditionDef>
		<defName>VoidAwake_Erosion_Light</defName>
		<conditionClass>VoidAwake.VoidAwake_GameCondition_ErosionLevel1</conditionClass>
		<label>ヴォイドの浸食LV１</label>
		<description>ヴォイドによる浸食の初期段階、フレッシュビーストやシャンブラーなどの下位の存在が出現し始めます。</description>
		<canBePermanent>true</canBePermanent>
		<exclusiveConditions>
			<li>VoidAwake_Erosion_Medium</li>
			<li>VoidAwake_Erosion_Heavy</li>
			<li>VoidAwake_Erosion_Extreme</li>
		</exclusiveConditions>
	</GameConditionDef>

	<!-- LV2: Medium -->
	<GameConditionDef>
		<defName>VoidAwake_Erosion_Medium</defName>
		<conditionClass>VoidAwake.VoidAwake_GameCondition_ErosionLevel2</conditionClass>
		<label>ヴォイドの浸食LV２</label>
		<description>ヴォイドの浸食が進んでいます、上位の存在が出現する可能性があります</description>
		<canBePermanent>true</canBePermanent>
		<exclusiveConditions>
			<li>VoidAwake_Erosion_Light</li>
			<li>VoidAwake_Erosion_Heavy</li>
			<li>VoidAwake_Erosion_Extreme</li>
		</exclusiveConditions>
	</GameConditionDef>

	<!-- LV3: Heavy（既存 ErosionLevel3 と対応） -->
	<GameConditionDef>
		<defName>VoidAwake_Erosion_Heavy</defName>
		<conditionClass>VoidAwake.VoidAwake_GameCondition_ErosionLevel3</conditionClass>
		<label>ヴォイドの浸食LV３</label>
		<description>この地域はヴォイドによって支配されています、野生動物はキメラに、植物は先触れの木へと変貌します</description>
		<canBePermanent>true</canBePermanent>
		<exclusiveConditions>
			<li>VoidAwake_Erosion_Light</li>
			<li>VoidAwake_Erosion_Medium</li>
			<li>VoidAwake_Erosion_Extreme</li>
		</exclusiveConditions>
	</GameConditionDef>

	<!-- LV4: Extreme -->
	<GameConditionDef>
		<defName>VoidAwake_Erosion_Extreme</defName>
		<conditionClass>VoidAwake.VoidAwake_GameCondition_ErosionLevel4</conditionClass>
		<label>ヴォイドの浸食LV４</label>
		<description>ヴォイドの浸食が完了しこの地はメタルヘルに変化しました</description>
		<canBePermanent>true</canBePermanent>
		<exclusiveConditions>
			<li>VoidAwake_Erosion_Light</li>
			<li>VoidAwake_Erosion_Medium</li>
			<li>VoidAwake_Erosion_Heavy</li>
		</exclusiveConditions>
	</GameConditionDef>

</Defs>