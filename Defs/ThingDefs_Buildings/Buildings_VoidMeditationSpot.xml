<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="BuildingBase">
		<defName>VoidAwake_VoidMeditationSpot</defName>
		<label>捻じれた瞑想スポット</label>
		<description>捻じれた瞑想を行う場所を指定する。ここで瞑想した入植者は、近くの収容プラットフォームに収容されたアノマリーとの繋がりを少しずつ深めていく。</description>
		<thingClass>VoidAwake.VoidAwake_Building_VoidMeditationSpot</thingClass>
		<graphicData>
			<texPath>Things/Building/Misc/PartySpot</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<altitudeLayer>FloorEmplacement</altitudeLayer>
		<statBases>
			<WorkToBuild>0</WorkToBuild>
		</statBases>
		<rotatable>false</rotatable>
		<scatterableOnMapGen>false</scatterableOnMapGen>
		<useHitPoints>False</useHitPoints>
		<passability>Standable</passability>
		<designationCategory>Misc</designationCategory>
		<uiOrder>2001</uiOrder>
		<drawGUIOverlay>true</drawGUIOverlay>
		<building>
			<sowTag>SupportPlantsOnly</sowTag>
			<canPlaceOverImpassablePlant>false</canPlaceOverImpassablePlant>
			<ai_chillDestination>false</ai_chillDestination>
			<wakeDormantPawnsOnConstruction>false</wakeDormantPawnsOnConstruction>
		</building>
		<comps>
			<li Class="VoidAwake.VoidAwake_CompProperties_MeditationAnchor">
				<radius>9.9</radius>
				<gainMultiplier>1.0</gainMultiplier>
			</li>
		</comps>
	</ThingDef>

</Defs>
