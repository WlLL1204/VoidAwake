<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- アノマリー 1 体分の脱走設定。events に並べたイベント Def が脱走時に順番に発火する。
	     新しいアノマリーに対応するときは、EscapeEventDefs.xml にイベントを 1 件足して
	     ここで参照する Def を 1 件追加するだけでよい。

	     entityDef と mutantDef の両方を省略した Def は、専用定義が無いアノマリー全ての既定になる。 -->

	<VoidAwake.VoidAwake_ContainmentEscapeDef>
		<defName>VoidAwake_ContainmentEscape_Default</defName>
		<label>収容破綻（既定）</label>
		<events>
			<li>VoidAwake_EscapeEvent_Default</li>
		</events>
	</VoidAwake.VoidAwake_ContainmentEscapeDef>

